
# Defining variables
# Logo key. Use Mod1 for Alt.
set $mod Mod4
# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l
# terminal emulator
set $term kitty
# application launcher
set $menu wofi --show drun
# file explorer
set $file_explorer thunar
# internet browser
