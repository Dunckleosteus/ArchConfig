{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "spacing": 2,
  "modules-left": ["sway/workspaces", "wlr/taskbar"],
  "modules-center": [ "custom/applauncher", "clock"],
  "modules-right": [
    "tray",
    //"bluetooth",
    "network",
    "pulseaudio",
    "cpu",
    "memory",
    "battery"
  ],
   "sway/workspaces": { // TODO: display current workspace
    "all-outputs": true,
    "disable-scroll": false,
    "tooltip": false,
    "format": "{index}",
    "persistent-workspaces": {
      "1":[],
      "2":[],
      "3":[],
      "4":[],
    }
  },
 "custom/applauncher": {
    "format": "\uf085",
    "on-click": "pgrep wofi >/dev/null 2>&1 && killall wofi || wofi --show drun --location=top -y 15",
    "tooltip": false
  },
  "memory":{
    "interval": 30,
    "format": "{used:0.1f}G/{total:0.1f}G ",
	  "max-length": 10,
    "tooltip-format": "{used}/{total} GB",
  },

  //"cpu": {
  //  "interval": 5,
  //  "format": "\uf2db",
  //  "tooltip": true,
  //  "on-click-right": "pgrep htop >/dev/null 2>&1 && killall htop || kitty -e htop"
  //},

  "cpu": {
     "interval": 5,
     "format": "{icon0}{icon1}{icon2}{icon3}",
     "format-icons": [
          "<span color='#a0a8b3'>▁</span>", // Ironbreaker - light load
          "<span color='#c7c7c7'>▂</span>", // Stormhost Silver
          "<span color='#5b6871'>▃</span>", // Leadbelcher
          "<span color='#5b6871'>▄</span>", // Leadbelcher
          "<span color='#00a0d8'>▅</span>", // Baharroth Blue
          "<span color='#00a0d8'>▆</span>", // Baharroth Blue
          "<span color='#9a1115'>▇</span>", // Mephiston Red
          "<span color='#db1e27'>█</span>"  // Wild Rider Red - max load
    ]
  },

  "clock": {
    "format": "{:L%A %H:%M}",
    "format-alt": "{:L%d %B W%V %Y}",
    "tooltip": false,
    "timezone": "Europe/Paris",
  },

  "network": {
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format": "{icon}",
    "format-wifi": "{icon}",
    "format-ethernet": "󰀂",
    "format-disconnected": "󰤮",
    "tooltip-format-wifi": "{essid} ({frequency} GHz)\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-ethernet": "⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 3,
    "spacing": 1,
    "on-click": "pgrep impala >/dev/null 2>&1 && killall impala || kitty -e impala"
  },
  "battery": {
      "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰂄{capacity}%",
    "format-alt": "{icon} {time}",
    "format-full": "󱈑 {capacity}%",
    "format-icons": [
      "󱊡",
      "󱊢",
      "󱊣"
    ],
    "tooltip-format-discharging": "{power:>1.0f}W↓ {capacity}%",
    "tooltip-format-charging": "{power:>1.0f}W↑ {capacity}%",
    "interval": 5,
    "on-click": "~/.config/waybar/scripts/power-menu.sh",
    "states": {
      "warning": 20,
      "critical": 10
    }
  },
  "pulseaudio": {
    "format": "{icon}",
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click-right": "pavucontrol",
    "tooltip-format": "Playing at {volume}%",
    "scroll-step": 5,
    "format-muted": "",
    "on-click-left": "pactl set-sink-volume @DEFAULT_SINK@ -100%", 
    "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
    "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%",
    "format-icons": {
      "headphone": "",
      "default": ["\uf026", "\uf027", "\uf028"]
    },
    "format-muted": "\uf00d {volume}%"
  },
  "tray": {
    "icon-size": 20,
    "spacing": 10
  },
  "wlr/taskbar": {
      "format": "{icon}",
      "icon-size": 20,
      "icon-theme": "Numix-Circle",
      "tooltip-format": "{title}",
      "on-click": "activate",
      "on-click-middle": "close"
  },
  "bluetooth": {
	  // "controller": "controller1", // specify the alias of the controller if there are more than 1 on the system
	  "format": " {status}",
	  "active-first": true,
	  "all-outputs": true,
	  "format-disabled": "", // an empty format will hide the module
	  "format-connected": " {num_connections} connected",
	  "tooltip-format": "{controller_alias}\t{controller_address}",
	  "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
	  "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
	  "on-click": "blueman-manager"
  }
}
